[flake8]
# Maximum line length
max-line-length = 120

# Ignore specific error codes (can be customized based on project needs)
ignore = 
    # E203: whitespace before ':'
    E203,
    # W503: line break before binary operator (conflicts with black)
    W503

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .eggs,
    log,
    image,
    nginx

# Per-file ignores (if needed)
per-file-ignores =
    __init__.py:F401

# Count the number of occurrences of each error/warning code
count = True

# Show the source code generating the error/warning
show-source = True

# Print total number of errors
statistics = True
